# ============================================================
# CreditWise Production Environment Variables
# ============================================================

# Google Gemini API Key (Server-Side Only)
# Required for AI-assisted natural language spending onboarding.
# If omitted or invalid, CreditWise seamlessly falls back to the deterministic parser.
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Optional)
# Supports MongoDB Atlas (mongodb+srv://) or local instances.
# If omitted, CreditWise functions in zero-cookie, client-storage mode.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cardwise?retryWrites=true&w=majority

# Base Public URL
# Used for canonical SEO metadata, Open Graph tags, and sitemap generation.
NEXT_PUBLIC_BASE_URL=https://creditwise-insights.vercel.app

# Node Environment ('development', 'production', 'test')
NODE_ENV=production

